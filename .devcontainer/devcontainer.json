{
  "name": "hacs-pypowerwall",
  "image": "python:3.14-bookworm",
  "postCreateCommand": "pip install -r requirements-dev.txt ruff",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ]
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "remoteUser": "vscode"
}
